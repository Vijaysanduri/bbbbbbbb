{
  "name": "dream2fly-backend",
  "version": "1.0.0",
  "description": "Dream2Fly Consulting — backend API (auth, leads, tasks, users) matching the Employee Dashboard v1.0 prototype",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/index.js",
   "start": "npx prisma db push --accept-data-loss && node src/index.js",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "create-user": "node scripts/create-user.js"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.18.0"
  }
}
